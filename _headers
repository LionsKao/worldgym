/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://*.g.doubleclick.net https://www.google.com https://www.google.com.tw; connect-src 'self' https://worldgym-api.lions2100.workers.dev https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://www.google.com https://www.google.com.tw https://cloudflareinsights.com; manifest-src 'self'; worker-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), geolocation=(self)
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# 靜態資源（CSS、JS、icon）一律快取 30 天（2592000 秒）。能這樣做的前提是：所有引用處都帶 ?v= 版號——
# 檔案內容改了，就要把引用它的地方的版號加一，使用者才會去抓新的；沒加的話使用者最久一個月看到舊的。
# 不加 immutable：這樣使用者按重新整理時，瀏覽器還是會向伺服器確認有沒有更新。
# sw.js 刻意不在這裡（Service Worker 本身要能隨時更新）；favicon.ico 是瀏覽器自己隱含請求的，沒辦法帶版號。
/style.css
  Cache-Control: public, max-age=2592000

/script.js
  Cache-Control: public, max-age=2592000

/common.js
  Cache-Control: public, max-age=2592000

/admin.js
  Cache-Control: public, max-age=2592000

/ga-init.js
  Cache-Control: public, max-age=2592000

/css-async.js
  Cache-Control: public, max-age=2592000

/vendor/*
  Cache-Control: public, max-age=2592000

/icons/*
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000
